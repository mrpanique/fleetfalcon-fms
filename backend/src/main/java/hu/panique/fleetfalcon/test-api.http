@baseUrl = http://localhost:8080


### 1) USER #1
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "email": "seed.admin1@fleetfalcon.test",
  "passwordHash": "AdminPass123!",
  "role": "ADMIN"
}

> {%
  client.global.set("user1Id", response.body.id);
%}

### 2) USER #2
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "email": "seed.employee1@fleetfalcon.test",
  "passwordHash": "EmployeePass123!",
  "role": "EMPLOYEE"
}

> {%
  client.global.set("user2Id", response.body.id);
%}

### 3) EMPLOYEE #1 (linked to USER #1)
POST {{baseUrl}}/api/employees
Content-Type: application/json

{
  "firstName": "Adam",
  "lastName": "Kovacs",
  "employeeId": "EMP-001",
  "user": {
    "id": {{user1Id}}
  },
  "phoneNumber": "+36300000001",
  "drivingLicenseNumber": "DL-SEED-001",
  "department": "Operations"
}

> {%
  client.global.set("employee1Id", response.body.id);
%}

### 4) EMPLOYEE #2 (linked to USER #2)
POST {{baseUrl}}/api/employees
Content-Type: application/json

{
  "firstName": "Bea",
  "lastName": "Nagy",
  "employeeId": "EMP-002",
  "user": {
    "id": {{user2Id}}
  },
  "phoneNumber": "+36300000002",
  "drivingLicenseNumber": "DL-SEED-002",
  "department": "Sales"
}

> {%
  client.global.set("employee2Id", response.body.id);
%}

### 5) VEHICLE #1
POST {{baseUrl}}/api/vehicles
Content-Type: application/json

{
  "brand": "Skoda",
  "model": "Octavia",
  "licensePlate": "SEED-VEH-001",
  "vehicleType": "CAR",
  "fuelType": "DIESEL",
  "releaseYear": 2021,
  "dailyPrice": 15000,
  "seatingCapacity": 5,
  "description": "Seed vehicle 1",
  "status": "AVAILABLE",
  "currentMileage": 84500,
  "inspectionValidUntil": "2027-10-31",
  "nextServiceMileage": 90000,
  "nextServiceDate": "2026-12-01"
}

> {%
  client.global.set("vehicle1Id", response.body.id);
%}

